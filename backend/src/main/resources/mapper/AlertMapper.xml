<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iot.smarthome.mapper.AlertMapper">
    <resultMap id="Base" type="com.iot.smarthome.entity.AlertRecord">
        <id column="id" property="id"/>
        <result column="device_id" property="deviceId"/>
        <result column="alert_type" property="alertType"/>
        <result column="level" property="level"/>
        <result column="message" property="message"/>
        <result column="is_read" property="isRead"/>
        <result column="create_time" property="createTime"/>
        <result column="device_name" property="deviceName"/>
    </resultMap>
    <select id="selectAll" resultMap="Base">
        SELECT a.*, d.name AS device_name FROM alert_record a LEFT JOIN device d ON a.device_id=d.id ORDER BY a.create_time DESC
    </select>
    <select id="selectUnread" resultMap="Base">
        SELECT a.*, d.name AS device_name FROM alert_record a LEFT JOIN device d ON a.device_id=d.id WHERE a.is_read=0 ORDER BY a.create_time DESC
    </select>
    <update id="markRead">UPDATE alert_record SET is_read=1 WHERE id=#{id}</update>
    <update id="markAllRead">UPDATE alert_record SET is_read=1</update>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO alert_record(device_id,alert_type,level,message) VALUES(#{deviceId},#{alertType},#{level},#{message})
    </insert>
    <select id="selectUnreadCount" resultType="int">SELECT COUNT(*) FROM alert_record WHERE is_read=0</select>
</mapper>
